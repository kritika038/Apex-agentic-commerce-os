# ==========================================
# APEX AGENTIC COMMERCE OS — BACKEND CONFIG
# ==========================================

PROJECT_NAME="Agentic Commerce OS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # "development" | "test" | "demo" | "production"

# Security & JWT
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Connection (SQLite local / PostgreSQL production)
DATABASE_URL="sqlite:///./commerce_os.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/commerce_os"

# Payment Provider (Razorpay Test Mode)
PAYMENT_PROVIDER="razorpay"  # "razorpay" | "mock"
RAZORPAY_MODE="test"         # strictly "test" for competition / sandbox
RAZORPAY_KEY_ID="rzp_test_your_test_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"
ALLOW_DEV_AUTH=True
MERCHANT_ADMIN_EMAILS="admin@apex.local,merchant@apex.local"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI Provider Configuration (LLM Gateway)
LLM_PROVIDER="openai"  # "openai" | "litellm" | "mock"
LLM_API_KEY="your_llm_api_key"

# Virtual Try-On Provider (Optional Local / FASHN)
FASHN_API_KEY=""

# Amazon Creators API (Optional)
AMAZON_CREATORS_API_ENABLED=False
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
AMAZON_PARTNER_TAG=""
AMAZON_MARKETPLACE="www.amazon.in"
